# EXEMPLO dos segredos do Streamlit Community Cloud (NÃO preencha valores aqui
# nem crie um secrets.toml real dentro do repositório — o repo é público).
#
# No deploy do painel em https://share.streamlit.io, cole o conteúdo abaixo
# (com os valores reais) em: App settings > Secrets. O formato é TOML plano
# (sem seções) — a ponte voofacil/secrets_bridge.py injeta cada chave como
# variável de ambiente para a config do app.

DATABASE_URL      = "postgresql+psycopg://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/NOMEDB?sslmode=require"
TP_TOKEN          = "seu_token_travelpayouts"
SERPAPI_KEY       = "sua_chave_serpapi"
TELEGRAM_TOKEN    = "123456:ABC-token-do-BotFather"
TELEGRAM_CHAT_ID  = "seu_chat_id"
SMTP_HOST         = "smtp.gmail.com"
SMTP_PORT         = "587"
SMTP_USER         = "voce@gmail.com"
SMTP_PASSWORD     = "senha_de_app_do_gmail"
ALERT_EMAIL_TO    = "voce@gmail.com"
