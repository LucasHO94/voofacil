# Copie para .env e preencha. O .env NUNCA vai para o git.

# --- Travelpayouts / Aviasales Data API (fonte primária, grátis) ---
# Cadastro: https://www.travelpayouts.com (programa Aviasales) -> token no painel
TP_TOKEN=

# --- SerpApi (confirmação de preço ao vivo + explore; free tier 250 buscas/mês) ---
# Cadastro: https://serpapi.com
SERPAPI_KEY=

# --- Telegram (canal primário de alerta) ---
# Crie o bot no @BotFather (/newbot) -> token. Envie /start ao bot e descubra
# seu chat_id em https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-mail via SMTP (canal secundário; Gmail exige senha de app) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Banco ---
# Vazio = SQLite local em data/voofacil.db (dev).
# Nuvem (Neon Postgres): use o driver psycopg v3 e SSL. Ex.:
#   postgresql+psycopg://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/NOMEDB?sslmode=require
DATABASE_URL=
