# Copie para .env e preencha. O .env NUNCA vai para o git.

# --- Travelpayouts / Aviasales Data API (fonte primária, grátis) ---
# Cadastro: https://www.travelpayouts.com (programa Aviasales) -> token no painel
TP_TOKEN=

# --- SerpApi (confirmação de preço ao vivo + explore; free tier 250 buscas/mês) ---
# Cadastro: https://serpapi.com
SERPAPI_KEY=

# --- Telegram (canal primário de alerta) ---
# Crie o bot no @BotFather (/newbot) -> token. Envie /start ao bot e descubra
# seu chat_id em https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-mail via SMTP (canal secundário; Gmail exige senha de app) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Banco ---
# Vazio = SQLite local em data/voofacil.db (dev).
# Nuvem (Neon Postgres): use o driver psycopg v3 e SSL. Ex.:
#   postgresql+psycopg://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/NOMEDB?sslmode=require
DATABASE_URL=

# --- Agendamento ---
# Usado só como SEED inicial do banco (tabela horario_agendado) na primeira
# vez que o app roda — depois disso, os horários são editáveis direto no
# painel Streamlit (aba "Agendamento") e o .env não é mais consultado.
# Não há evidência forte de "hora do dia com menor preço": o espalhamento
# abaixo serve pra cobrir o dia e não concentrar chamadas, não pra acertar
# uma hora mágica.
SCAN_HORARIOS=06:00,12:30,21:00
SCAN_DIAS_SEMANA=*
EXPLORE_HORARIO=05:00

# GitHub Actions e o daemon local não conseguem ler o banco a cada minuto, então
# rodam num POLL de frequência fixa e curta (agendamento_poll_minutos) e cada
# execução decide, via deve_rodar_agora(), se é hora de varrer/explorar de
# verdade (tolerância = agendamento_tolerancia_minutos). Tolerância precisa ser
# < poll_minutos/2, senão o mesmo horário pode disparar em dobro.
AGENDAMENTO_TOLERANCIA_MINUTOS=7
AGENDAMENTO_POLL_MINUTOS=15
